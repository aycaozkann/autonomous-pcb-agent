		(effects (font (size 2 2)) (justify left))
		(uuid "faf84d30-e078-5c16-9e79-0f485c520596")
	)
	(text "Baglantilarin tek kaynagi: build/netlist.net (KiCad 10.0.4) - net adlari ve dugum sayilari netlist'ten dogrulanmistir. BU SAYFA SEMBOL ICERMEZ, ERC KOSMAZ."
		(at 15 24 0)
		(effects (font (size 1.6 1.6)) (justify left))
		(uuid "f4ae7fa9-5d72-5439-b93b-59dff790ccc2")
	)
	(text "Elektriksel gercek daima board.kicad_sch / board.kicad_pcb'dir (DRC 0/0, commit 6acd4e4 - bkz. TEST/pcb_yerlesim_raporu.md)."
		(at 15 28.5 0)
		(effects (font (size 1.6 1.6)) (justify left))
		(uuid "ef262fb9-5d86-506d-b6cc-9beae1ec61da")
